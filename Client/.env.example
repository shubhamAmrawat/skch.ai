# Copy this file to .env and fill in real values.
# Vite only exposes vars prefixed with VITE_ to client code.

VITE_API_BASE_URL=http://localhost:3000/api
VITE_AUTH_API_BASE_URL=http://localhost:3000/api/auth

# Google OAuth Client ID (safe to share — only the Client SECRET is sensitive,
# and that lives on the server only). Missing this crashes GoogleOAuthProvider
# with a blank white login page.
VITE_GOOGLE_CLIENT_ID=
