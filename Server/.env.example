# Copy this file to .env and fill in real values. Never commit the real .env.

PORT=3000
NODE_ENV=development

# IMPORTANT: include the database name in the path (e.g. .../sktchAi?...).
# Omitting it silently connects you to MongoDB's default "test" database,
# which looks empty even though your real data is in "sktchAi".
DB_URI=mongodb+srv://<user>:<password>@<cluster-host>/sktchAi?retryWrites=true&w=majority

JWT_SECRET=

# AI providers — at least one is required; aiController.js routes by model-name prefix.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Google OAuth — same Client ID as Client/.env's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Comma-separated list, no trailing slash on each origin.
ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (asset storage)
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

APP_URL=http://localhost:5173
